APP_ENV=development
# Vacio = enlaces relativos (recomendado para Docker y para el router local).
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=testdb
DB_USER=biblioteca_user
DB_PASSWORD=replace-with-server-password

# --- Solo para Docker (compose.yaml) ---
# Contrasena de root de MySQL dentro del contenedor "db".
MYSQL_ROOT_PASSWORD=replace-with-root-password
# Puerto del host publicado por el contenedor web (80 en el servidor).
WEB_PORT=80
# Zona horaria de PHP y MySQL en los contenedores.
TZ=America/La_Paz
